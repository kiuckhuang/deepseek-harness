diff --git a/scripts/pnpm-invocation.ts b/scripts/pnpm-invocation.ts
new file mode 100644
index 0000000000..3ff108910f
--- /dev/null
+++ b/scripts/pnpm-invocation.ts
@@ -0,0 +1,39 @@
+import { existsSync, readFileSync } from 'node:fs'
+
+/** The command and arguments needed to invoke pnpm without a shell. */
+export interface PnpmInvocation {
+  command: string
+  args: string[]
+}
+
+/** Resolve a package-manager entrypoint for a direct child-process spawn.
+ * @param entrypoint - Value supplied by `npm_execpath`.
+ * @returns The executable and arguments for the pnpm invocation.
+ */
+export function pnpmInvocation(entrypoint: string): PnpmInvocation {
+  if (isDirectExecutable(entrypoint)) return { command: entrypoint, args: [] }
+  return { command: process.execPath, args: [entrypoint] }
+}
+
+function isDirectExecutable(entrypoint: string): boolean {
+  if (!existsSync(entrypoint)) return false
+  const bytes = readFileSync(entrypoint).subarray(0, 4)
+  return isShebang(bytes) || isElf(bytes) || isWindowsExecutable(bytes) || isMachO(bytes)
+}
+
+function isShebang(bytes: Uint8Array): boolean {
+  return bytes[0] === 0x23 && bytes[1] === 0x21
+}
+
+function isElf(bytes: Uint8Array): boolean {
+  return bytes[0] === 0x7f && bytes[1] === 0x45 && bytes[2] === 0x4c && bytes[3] === 0x46
+}
+
+function isWindowsExecutable(bytes: Uint8Array): boolean {
+  return bytes[0] === 0x4d && bytes[1] === 0x5a
+}
+
+function isMachO(bytes: Uint8Array): boolean {
+  const magic = (bytes[0] ?? 0) | ((bytes[1] ?? 0) << 8) | ((bytes[2] ?? 0) << 16) | ((bytes[3] ?? 0) << 24)
+  return magic === 0xfeedface || magic === 0xcefaedfe || magic === 0xfeedfacf || magic === 0xcffaedfe
+}

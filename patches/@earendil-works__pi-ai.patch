+import type { Api, Model } from "../types.js";
+/**
+ * Supplement an absent GPT-6.1 Sol entry; preserve a native Copilot entry.
+ * @param copilotModels - installed Copilot models indexed by request id.
+ * @param openaiModels - installed OpenAI models indexed by request id.
+ * @returns the complete catalog, or the original catalog when the id exists.
+ * @throws Error if the required model or Copilot transport metadata is absent.
+ */
+export declare function completeGitHubCopilotCatalog(copilotModels: Readonly<Record<string, Model<Api>>>, openaiModels: Readonly<Record<string, Model<Api>>>): Readonly<Record<string, Model<Api>>>;

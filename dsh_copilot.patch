++/** Complete missing Copilot metadata without replacing native upstream entries. */
++export function completeGitHubCopilotCatalog(copilotModels, openaiModels) {
++    const id = "gpt-6.1-sol";
++    if (Object.hasOwn(copilotModels, id)) return copilotModels;
++    const model = openaiModels[id];
++    const transport = copilotModels["gpt-6-sol"];
++    if (model === undefined
++        || transport === undefined
++        || model.api !== transport.api
++        || transport.headers === undefined
++        || transport.compat === undefined
++        || transport.inputLimits === undefined) {
++        throw new Error(
++            "The GitHub Copilot GPT-6.1 Sol patch requires matching OpenAI GPT-6.1 Sol"
++            + " and complete GitHub Copilot GPT-6 Sol transport metadata; review the pi-ai patch"
++        );
++    }
++    return {
++        ...copilotModels,
++        [id]: {
++            ...model,
++            provider: "github-copilot",
++            baseUrl: transport.baseUrl,
++            contextWindow: transport.contextWindow,
++            headers: transport.headers,
++            compat: transport.compat,
++            inputLimits: transport.inputLimits,
++        },
++    };
++}
++
++// GitHub's supported-model list owns Copilot availability. Model capacities
++// and reasoning levels come from pi-ai's OpenAI catalog; Copilot transport
++// settings come from its GPT-6 Sol catalog entry. A native entry takes priority.
++// https://docs.github.com/en/copilot/reference/ai-models/supported-models
